.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# The source dataset is CC BY-NC 4.0 and must be downloaded from Mendeley.
Raw Raman spectral datasets of TEP, DIMP, and DMMP/
data/raw/

# Reproducible generated data. Final models, reports, and board samples are
# intentionally retained as project deliverables under artifacts/.
data/processed/*
!data/processed/.gitkeep

# Model Zoo / Hydra outputs.
outputs/
mlruns/
**/experiments_outputs/

# Generated and unrelated full-project material remains outside this focused
# repository. The small set of Linear Softmax STM32 files required by the
# README is explicitly included below.
artifacts/
scripts/*
!scripts/install_model_zoo_overlay.py
!scripts/verify_reproduction.py
!scripts/verify_stm32n6_prediction.py
integration/
firmware/
configs/stm32_model_zoo/*
!configs/stm32_model_zoo/linear_softmax_training_config.yaml
!configs/stm32_model_zoo/linear_softmax_evaluation_float_config.yaml
!configs/stm32_model_zoo/linear_softmax_quantization_config.yaml
!configs/stm32_model_zoo/linear_softmax_evaluation_int8_config.yaml
!configs/stm32_model_zoo/linear_softmax_benchmarking_stm32n6_config.yaml
!configs/stm32_model_zoo/linear_softmax_benchmarking_stm32u5_config.yaml
!configs/stm32_model_zoo/linear_softmax_benchmarking_stm32f4_config.yaml
!configs/stm32_model_zoo/linear_softmax_prediction_host_config.yaml
!configs/stm32_model_zoo/linear_softmax_prediction_stm32n6_config.yaml
docs/DEPLOYMENT_STM32N6.md
docs/MODEL_CARD.md
docs/RAPPORTO_INCREMENTALE_IT.md
README_FULL_PROJECT.md
